# Copy this file to .env and replace both passwords before starting the stack.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_USER=petclinic
MYSQL_PASSWORD=replace-with-a-local-app-password

# Optional: only required when starting genai-service.
OPENAI_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
